{
  "name": "brcmp/compare-widget",
  "d4Shortcode": "et_pb_brcmp_compare_widget",
  "title": "BeRocket Compare Widget",
  "titles": "BeRocket Compare Widgets",
  "category": "module",
  "moduleClassName": "et_pb_brcmp_compare_widget",
  "moduleOrderClassName": "et_pb_brcmp_compare_widget",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "advanced": { "html": {} },
        "meta": { "adminLabel": {} },
        "decoration": { "layout": {}, "disabledOn": {} }
      }
    },
    "title": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "component": { "name": "divi/text", "type": "field" }
          }
        }
      }
    },
    "fast_compare": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 20,
            "render": true,
            "attrName": "fast_compare.innerContent",
            "label": "Fast compare to load compare table via AJAX",
            "component": { "name": "divi/toggle", "type": "field" }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 30,
            "render": true,
            "attrName": "type.innerContent",
            "label": "Type",
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "image": { "label": "Image" },
                  "text": { "label": "Text" }
                }
              }
            }
          }
        }
      }
    },
    "toolbar": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 40,
            "render": true,
            "attrName": "toolbar.innerContent",
            "label": "Is ToolBar",
            "component": { "name": "divi/toggle", "type": "field" }
          }
        }
      }
    },
    "compareButton": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCompareButton",
              "attrName": "compareButton.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Compare Button" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .berocket_compare_widget .berocket_open_compare",
          "important": true
        }
      }
    },
    "productLabel": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProductLabel",
              "attrName": "productLabel.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Product Label" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .berocket_compare_widget ul li span",
          "important": true
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentOptions": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentOptions",
        "multiElements": true,
        "component": { "name": "divi/composite", "props": { "groupLabel": "Content" } }
      },
      "designCompareButton": {
        "panel": "design",
        "priority": 10,
        "groupName": "designCompareButton",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Compare Button" } }
      },
      "designProductLabel": {
        "panel": "design",
        "priority": 20,
        "groupName": "designProductLabel",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Product Label" } }
      }
    }
  },
  "defaultAttrs": {
    "title": { "innerContent": { "desktop": { "value": "" } } },
    "fast_compare": { "innerContent": { "desktop": { "value": "off" } } },
    "type": { "innerContent": { "desktop": { "value": "image" } } },
    "toolbar": { "innerContent": { "desktop": { "value": "off" } } }
  }
}
