{
  "name": "brcmp/compare-table",
  "d4Shortcode": "et_pb_brcmp_compare_table",
  "title": "BeRocket Compare Table",
  "titles": "BeRocket Compare Tables",
  "category": "module",
  "moduleClassName": "et_pb_brcmp_compare_table",
  "moduleOrderClassName": "et_pb_brcmp_compare_table",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "advanced": { "html": {} },
        "meta": { "adminLabel": {} },
        "decoration": { "layout": {}, "disabledOn": {} }
      }
    },
    "productTitle": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProductTitle",
              "attrName": "productTitle.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Product Title" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_new_compare_block .br_top_table .br_main_top th h1, {{selector}} .br_new_compare_block .br_top_table .br_main_top th h2, {{selector}} .br_new_compare_block .br_top_table .br_main_top th h3, {{selector}} .br_new_compare_block .br_top_table .br_main_top th h4",
          "important": true
        }
      }
    },
    "productPrice": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designProductPrice",
              "attrName": "productPrice.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Product Price" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_new_compare_block .br_top_table .br_compare_price *",
          "important": true
        }
      }
    },
    "attributeName": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designAttributeName",
              "attrName": "attributeName.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Attribute Names" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_new_compare .br_left_table tr th",
          "important": true
        }
      }
    },
    "attributeValue": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designAttributeValue",
              "attrName": "attributeValue.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Attribute Values" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_new_compare .br_right_table tr td, {{selector}} .br_new_compare .br_right_table tr td *",
          "important": true
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "designProductTitle": {
        "panel": "design",
        "priority": 10,
        "groupName": "designProductTitle",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Product Title" } }
      },
      "designProductPrice": {
        "panel": "design",
        "priority": 20,
        "groupName": "designProductPrice",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Product Price" } }
      },
      "designAttributeName": {
        "panel": "design",
        "priority": 30,
        "groupName": "designAttributeName",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Attribute Names" } }
      },
      "designAttributeValue": {
        "panel": "design",
        "priority": 40,
        "groupName": "designAttributeValue",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Attribute Values" } }
      }
    }
  },
  "defaultAttrs": {}
}
