{
  "name": "brcmp/compare-button",
  "d4Shortcode": "et_pb_br_compare_button",
  "title": "BeRocket Compare Button",
  "titles": "BeRocket Compare Buttons",
  "category": "module",
  "moduleClassName": "et_pb_br_compare_button",
  "moduleOrderClassName": "et_pb_br_compare_button",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "advanced": { "html": {} },
        "meta": { "adminLabel": {} },
        "decoration": { "layout": {}, "disabledOn": {} }
      }
    },
    "content": {
      "type": "object",
      "settings": {
        "advanced": {
          "product": {
            "groupType": "group-item",
            "item": {
              "attrName": "content.advanced.product",
              "description": "Here you can select the Product.",
              "label": "Product",
              "groupSlug": "contentOptions",
              "priority": 10,
              "render": true,
              "features": {
                "responsive": false,
                "hover": false,
                "sticky": false,
                "preset": "content"
              },
              "component": { "type": "field" }
            }
          }
        }
      }
    },
    "fast_compare": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 20,
            "render": true,
            "attrName": "fast_compare.innerContent",
            "label": "Fast compare",
            "component": { "name": "divi/toggle", "type": "field" }
          }
        }
      }
    },
    "add_compare": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 30,
            "render": true,
            "attrName": "add_compare.innerContent",
            "label": "Add to compare button",
            "component": { "name": "divi/text", "type": "field" }
          }
        }
      }
    },
    "added_compare": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 40,
            "render": true,
            "attrName": "added_compare.innerContent",
            "label": "Add to compare button if product added",
            "component": { "name": "divi/text", "type": "field" }
          }
        }
      }
    },
    "button": {
      "type": "object",
      "selector": "{{selector}} .br_compare_button",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButton",
              "attrName": "button.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Button" }
              }
            }
          },
          "border": {}
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_compare_button .br_compare_button_text",
          "important": true
        },
        "border": {
          "selector": "{{selector}} div a.br_compare_button.button"
        }
      }
    },
    "checkMark": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCheckMark",
              "attrName": "checkMark.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": { "grouped": true, "fieldLabel": "Check Mark" }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .br_compare_button .fa",
          "important": true
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentOptions": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentOptions",
        "multiElements": true,
        "component": { "name": "divi/composite", "props": { "groupLabel": "Content" } }
      },
      "designButton": {
        "panel": "design",
        "priority": 10,
        "groupName": "designButton",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Button" } }
      },
      "designCheckMark": {
        "panel": "design",
        "priority": 20,
        "groupName": "designCheckMark",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Check Mark" } }
      }
    }
  },
  "defaultAttrs": {
    "content": {
      "advanced": {
        "product": { "desktop": { "value": "dynamic" } }
      }
    },
    "fast_compare": { "innerContent": { "desktop": { "value": "on" } } },
    "add_compare": { "innerContent": { "desktop": { "value": "" } } },
    "added_compare": { "innerContent": { "desktop": { "value": "" } } }
  }
}
